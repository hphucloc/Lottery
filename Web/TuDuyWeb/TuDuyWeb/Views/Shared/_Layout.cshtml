    <title>@ViewBag.Title - Tu Duy Moi Ngay</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
</head>
<body>
    <div class="page-shell">
        <header class="site-header">
            <div>
                <a class="brand" href="@Url.Action("Index", "Home")">tuduy.vietnamlott.net</a>
                <p class="subtitle">Khung ghi lai tu duy, cam xuc, quyet dinh va bai hoc moi ngay.</p>
            </div>
            <nav class="site-nav">
                <a href="@Url.Action("Index", "Home")">Hom nay</a>
